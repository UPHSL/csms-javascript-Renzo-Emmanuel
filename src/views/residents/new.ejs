<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register Resident - CSMS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="main-nav">
    <span class="nav-brand">CSMS</span>
    <div class="nav-links">
      <a href="/dashboard" class="nav-link">
        <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
        Dashboard
      </a>
      <a href="/residents" class="nav-link nav-link-active">
        <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zm8 0a3 3 0 11-6 0 3 3 0 016 0zM2.5 16.5a6.5 6.5 0 0115 0H2.5z"/></svg>
        Residents
      </a>
      <a href="/service-requests" class="nav-link">
        <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm6 3a1 1 0 000 2h2a1 1 0 100-2h-2zm-2 4a1 1 0 011-1h4a1 1 0 110 2H9a1 1 0 01-1-1z" clip-rule="evenodd"/></svg>
        Service Requests
      </a>
    </div>
  </nav>

  <main class="page-container">
    <div class="page-header">
      <div class="page-header-text">
        <span class="overline">Community Services Management System</span>
        <h1>Register Resident</h1>
      </div>
      <a href="/residents" class="btn btn-secondary">Back to Residents</a>
    </div>

    <% if (errors.length > 0) { %>
      <div class="alert alert-error" role="alert">
        <strong>Please correct the following errors:</strong>
        <ul class="error-list">
          <% errors.forEach(function(field) { %>
            <li><%= ({
              firstName: 'First name is required.',
              lastName: 'Last name is required.',
              address: 'Address is required.',
              contactNumber: 'Contact number must follow the format 09XXXXXXXXX.',
              email: 'Email address is invalid.',
              status: 'Status is invalid.'
            })[field] || (field + ' is invalid.') %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <section class="card">
      <form method="POST" action="/residents" novalidate>
        <div class="form-group">
          <label for="firstName" class="form-label">First Name</label>
          <input
            type="text"
            id="firstName"
            name="firstName"
            value="<%= formData.firstName || '' %>"
            class="form-input<%= errors.includes('firstName') ? ' input-error' : '' %>"
            autocomplete="given-name"
          >
          <% if (errors.includes('firstName')) { %>
            <span class="field-error">First name is required.</span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="lastName" class="form-label">Last Name</label>
          <input
            type="text"
            id="lastName"
            name="lastName"
            value="<%= formData.lastName || '' %>"
            class="form-input<%= errors.includes('lastName') ? ' input-error' : '' %>"
            autocomplete="family-name"
          >
          <% if (errors.includes('lastName')) { %>
            <span class="field-error">Last name is required.</span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="address" class="form-label">Address</label>
          <input
            type="text"
            id="address"
            name="address"
            value="<%= formData.address || '' %>"
            class="form-input<%= errors.includes('address') ? ' input-error' : '' %>"
            autocomplete="street-address"
          >
          <% if (errors.includes('address')) { %>
            <span class="field-error">Address is required.</span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="contactNumber" class="form-label">Contact Number</label>
          <input
            type="text"
            id="contactNumber"
            name="contactNumber"
            value="<%= formData.contactNumber || '' %>"
            class="form-input<%= errors.includes('contactNumber') ? ' input-error' : '' %>"
            placeholder="09XXXXXXXXX"
            autocomplete="tel"
          >
          <% if (errors.includes('contactNumber')) { %>
            <span class="field-error">Contact number must follow the format 09XXXXXXXXX.</span>
          <% } %>
        </div>

        <div class="form-group">
          <label for="email" class="form-label">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            value="<%= formData.email || '' %>"
            class="form-input<%= errors.includes('email') ? ' input-error' : '' %>"
            autocomplete="email"
          >
          <% if (errors.includes('email')) { %>
            <span class="field-error">Email address is invalid.</span>
          <% } %>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Register Resident</button>
          <a href="/residents" class="btn btn-secondary">Cancel</a>
        </div>
      </form>
    </section>
  </main>
</body>
</html>
