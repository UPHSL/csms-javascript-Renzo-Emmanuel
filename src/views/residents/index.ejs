<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resident Management - CSMS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="main-nav">
    <span class="nav-brand">CSMS</span>
    <div class="nav-links">
      <a href="/dashboard" class="nav-link">
        <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
        Dashboard
      </a>
      <a href="/residents" class="nav-link nav-link-active">
        <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zm8 0a3 3 0 11-6 0 3 3 0 016 0zM2.5 16.5a6.5 6.5 0 0115 0H2.5z"/></svg>
        Residents
      </a>
      <a href="/service-requests" class="nav-link">
        <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm6 3a1 1 0 000 2h2a1 1 0 100-2h-2zm-2 4a1 1 0 011-1h4a1 1 0 110 2H9a1 1 0 01-1-1z" clip-rule="evenodd"/></svg>
        Service Requests
      </a>
    </div>
  </nav>

  <main class="page-container">
    <div class="page-header">
      <div class="page-header-text">
        <span class="overline">Community Services Management System</span>
        <h1>Resident Management</h1>
      </div>
      <a href="/residents/new" class="btn btn-primary">
        <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
        Register Resident
      </a>
    </div>

    <% if (successMessage) { %>
      <div class="alert alert-success" role="alert">
        <svg style="width:16px;height:16px;flex-shrink:0;" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
        <%= successMessage %>
      </div>
    <% } %>

    <section class="card">
      <form method="GET" action="/residents" class="search-form">
        <div class="search-group">
          <label for="q" class="search-label">Search by name</label>
          <div class="search-row">
            <input
              type="text"
              id="q"
              name="q"
              value="<%= searchTerm %>"
              placeholder="Enter first or last name..."
              class="form-input"
            >
            <button type="submit" class="btn btn-secondary">
              <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/></svg>
              Search
            </button>
            <% if (searchTerm) { %>
              <a href="/residents" class="btn btn-link">Clear</a>
            <% } %>
          </div>
        </div>
      </form>
    </section>

    <section class="card">
      <% if (residents.length === 0) { %>
        <span class="empty-message">No Residents found.</span>
      <% } else { %>
        <div class="table-wrapper">
          <table class="residents-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Address</th>
                <th>Contact</th>
                <th>Email</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% residents.forEach(function(resident) { %>
                <tr>
                  <td style="color:var(--text-muted);font-size:0.82rem;font-weight:600;">#<%= resident.id %></td>
                  <td style="font-weight:600;"><%= resident.firstName %> <%= resident.lastName %></td>
                  <td style="color:var(--text-secondary);"><%= resident.address %></td>
                  <td style="color:var(--text-secondary);"><%= resident.contactNumber %></td>
                  <td style="color:var(--text-secondary);"><%= resident.email %></td>
                  <td>
                    <span class="badge badge-<%= resident.status === 'Active' ? 'active' : 'inactive' %>">
                      <%= resident.status %>
                    </span>
                  </td>
                  <td class="actions-cell">
                    <%# Edit — top row %>
                    <a href="/residents/<%= resident.id %>/edit" class="btn btn-sm btn-secondary">
                      <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zm-2.207 2.207L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"/></svg>
                      Edit
                    </a>
                    <%# Deactivate — bottom row, smaller text %>
                    <% if (resident.status === 'Active') { %>
                      <form
                        method="POST"
                        action="/residents/<%= resident.id %>/deactivate"
                        class="inline-form"
                        onsubmit="return confirm('Deactivate this resident?')"
                      >
                        <button type="submit" class="btn btn-sm-xs btn-danger">
                          <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M13.477 14.89A6 6 0 015.11 6.524L13.477 14.89zm1.414-1.414L6.524 5.11a6 6 0 018.367 8.367zM18 10a8 8 0 11-16 0 8 8 0 0116 0z" clip-rule="evenodd"/></svg>
                          Deactivate
                        </button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <footer class="app-footer">
    Community Services Management System &nbsp;&middot;&nbsp; v<%= appVersion %>
  </footer>

</body>
</html>
