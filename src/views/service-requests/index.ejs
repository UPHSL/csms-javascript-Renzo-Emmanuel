<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Service Request Management - CSMS</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="main-nav">
    <span class="nav-brand">CSMS</span>
    <div class="nav-links">
      <a href="/dashboard" class="nav-link">
        <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg>
        Dashboard
      </a>
      <a href="/residents" class="nav-link">
        <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path d="M9 6a3 3 0 11-6 0 3 3 0 016 0zm8 0a3 3 0 11-6 0 3 3 0 016 0zM2.5 16.5a6.5 6.5 0 0115 0H2.5z"/></svg>
        Residents
      </a>
      <a href="/service-requests" class="nav-link nav-link-active">
        <svg class="nav-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm6 3a1 1 0 000 2h2a1 1 0 100-2h-2zm-2 4a1 1 0 011-1h4a1 1 0 110 2H9a1 1 0 01-1-1z" clip-rule="evenodd"/></svg>
        Service Requests
      </a>
    </div>
  </nav>

  <main class="page-container">
    <div class="page-header">
      <div class="page-header-text">
        <span class="overline">Community Services Management System</span>
        <h1>Service Request Management</h1>
      </div>
      <a href="/service-requests/new" class="btn btn-primary">
        <svg class="btn-icon" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M10 3a1 1 0 011 1v5h5a1 1 0 110 2h-5v5a1 1 0 11-2 0v-5H4a1 1 0 110-2h5V4a1 1 0 011-1z" clip-rule="evenodd"/></svg>
        Submit Service Request
      </a>
    </div>

    <% if (successMessage) { %>
      <div class="alert alert-success" role="alert">
        <%= successMessage %>
      </div>
    <% } %>

    <section class="card">
      <form method="GET" action="/service-requests" class="search-form">
        <div class="search-filter-row">
          <div class="search-group">
            <label for="q" class="search-label">Search by service type or description</label>
            <div class="search-row">
              <input
                type="text"
                id="q"
                name="q"
                value="<%= searchTerm %>"
                placeholder="Enter service type or description..."
                class="form-input"
              >
            </div>
          </div>

          <div class="search-group">
            <label for="status" class="search-label">Filter by status</label>
            <div class="search-row">
              <select id="status" name="status" class="form-input form-select">
                <option value="all"       <%= selectedStatus === 'all'         ? 'selected' : '' %>>All Statuses</option>
                <option value="Pending"   <%= selectedStatus === 'Pending'     ? 'selected' : '' %>>Pending</option>
                <option value="In Progress" <%= selectedStatus === 'In Progress' ? 'selected' : '' %>>In Progress</option>
                <option value="Completed" <%= selectedStatus === 'Completed'   ? 'selected' : '' %>>Completed</option>
                <option value="Cancelled" <%= selectedStatus === 'Cancelled'   ? 'selected' : '' %>>Cancelled</option>
              </select>
            </div>
          </div>

          <div class="search-group search-group-action">
            <label class="search-label">&nbsp;</label>
            <div class="search-row">
              <button type="submit" class="btn btn-secondary">Search / Filter</button>
              <% if (searchTerm || (selectedStatus && selectedStatus !== 'all')) { %>
                <a href="/service-requests" class="btn btn-link">Clear</a>
              <% } %>
            </div>
          </div>
        </div>
      </form>
    </section>

    <section class="card">
      <% if (serviceRequests.length === 0) { %>
        <p class="empty-message">No Service Requests found.</p>
      <% } else { %>
        <div class="table-wrapper">
          <table class="residents-table">
            <thead>
              <tr>
                <th>ID</th>
                <th>Resident ID</th>
                <th>Service Type</th>
                <th>Date Requested</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% serviceRequests.forEach(function(sr) { %>
                <tr>
                  <td><%= sr.id %></td>
                  <td><%= sr.residentId %></td>
                  <td><%= sr.serviceType %></td>
                  <td><%= sr.dateRequested %></td>
                  <td>
                    <span class="badge badge-<%= sr.status.toLowerCase().replace(' ', '-') %>">
                      <%= sr.status %>
                    </span>
                  </td>
                  <td class="actions-cell">
                    <a href="/service-requests/<%= sr.id %>" class="btn btn-sm btn-secondary">View</a>

                    <% if (sr.status === 'Pending') { %>
                      <form method="POST" action="/service-requests/<%= sr.id %>/process" class="inline-form">
                        <button type="submit" class="btn btn-sm btn-primary">Start Processing</button>
                      </form>
                      <form method="POST" action="/service-requests/<%= sr.id %>/cancel" class="inline-form"
                            onsubmit="return confirm('Cancel this Service Request?')">
                        <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                      </form>
                    <% } else if (sr.status === 'In Progress') { %>
                      <form method="POST" action="/service-requests/<%= sr.id %>/complete" class="inline-form">
                        <button type="submit" class="btn btn-sm btn-success">Complete</button>
                      </form>
                      <form method="POST" action="/service-requests/<%= sr.id %>/cancel" class="inline-form"
                            onsubmit="return confirm('Cancel this Service Request?')">
                        <button type="submit" class="btn btn-sm btn-danger">Cancel</button>
                      </form>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>

  <footer class="app-footer">
    Community Services Management System &nbsp;&middot;&nbsp; v<%= appVersion %>
  </footer>

</body>
</html>
